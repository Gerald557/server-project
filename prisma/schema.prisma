datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
 id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Machine {
  id               Int      @id @default(autoincrement())
  name             String
  type             String  
  serial_number    String   @unique
  location         String 
  status           String   @default("OPERATIONAL") 
  created_by_id    Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Inspection {
  id           Int      @id @default(autoincrement())
  machine_id   Int     
  inspector_id Int      
  result       String   
  notes        String   
  created_at   DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Fault {
  id                 Int      @id @default(autoincrement())
  machine_id         Int      
  inspection_id      Int? 
  fault_description  String   
  severity           String   
  reported_by_id     Int      
  recommended_action String   
  status             String   @default("draft") 
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model WorkOrder {
  id             Int      @id @default(autoincrement())
  machine_id     Int      
  fault_id       Int?     
  description    String   
  assigned_to_id Int?     
  status         String   @default("pending")
  created_by_id  Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}


model SparePart {
  id                  Int      @id @default(autoincrement())
  name                String   
  part_number         String   @unique
  quantity_in_stock   Int      
  low_stock_threshold Int      @default(5)
  unit_cost           Float    
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model WorkOrderPart {
  id            Int      @id @default(autoincrement())
  work_order_id Int      
  spare_part_id Int      
  quantity_used Int      
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
